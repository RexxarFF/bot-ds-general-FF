# ============================================================
# FunFernus Bot — ОБЩИЙ .env
# Скопируй этот файл в .env рядом с main.py
# Никогда не публикуй .env и не отправляй его посторонним.
# ============================================================

# ---------------- DISCORD ----------------
DISCORD_TOKEN=PASTE_DISCORD_BOT_TOKEN_HERE
GUILD_ID=PASTE_DISCORD_SERVER_ID
CONFIG_CHANNEL_ID=PASTE_CONFIG_CHANNEL_ID
# Discord user ID администраторов через запятую
ADMIN_USER_IDS=123456789012345678

# ---------------- MINECRAFT / RCON ----------------
# Для первого теста можно оставить test mode=true.
RCON_TEST_MODE=true
RCON_ENABLED=false
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=PASTE_RCON_PASSWORD_HERE

# ---------------- WEBSITE DATABASE ----------------
WEB_DB_HOST=PASTE_MYSQL_HOST
WEB_DB_PORT=3306
WEB_DB_NAME=PASTE_DATABASE_NAME
WEB_DB_USER=PASTE_DATABASE_USER
WEB_DB_PASSWORD=PASTE_DATABASE_PASSWORD
WEB_DB_SSL=true
WEB_PUBLIC_URL=https://funfernus.ru

# ---------------- REALTIME / WEBSOCKET ----------------
REALTIME_ENABLED=true
# Для Bothost обязательно 0.0.0.0
REALTIME_HOST=0.0.0.0
# На Bothost переменная PORT из панели имеет приоритет автоматически.
# Это значение используется только если PORT не задан платформой.
REALTIME_PORT=8000
REALTIME_PATH=/ws
REALTIME_SECRET=2835595dc75d0dea325164a7a4d77e27b5dbe1d63068876e7c94d187735e54c5
REALTIME_ALLOWED_ORIGINS=https://funfernus.ru,https://www.funfernus.ru
REALTIME_MAX_CONNECTIONS_PER_USER=8
REALTIME_HEARTBEAT_SECONDS=25
# После создания домена Bothost замени адрес ниже.
REALTIME_PUBLIC_URL=wss://YOUR-SUBDOMAIN.bothost.tech/ws
